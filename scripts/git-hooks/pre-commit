#!/bin/sh
# 커밋 전 문자 위생 검사 — 한자 혼입 · U+FFFD · 충돌 마커 (2026-09-28)
#
# 왜 훅인가: 한자 혼입이 **한 세션에 4회** 재발했다. 사람이 기억으로 하는 점검이 안 된다.
# "이번엔 놓치지 않겠다" 는 3번 실패했고, **도구가 대신 막아야 한다.**
#
# 설치: git config core.hooksPath scripts/git-hooks
# 우회: git commit --no-verify (단, 사유를 PR 본문에 남길 것)
#
# 주의: 검사 대상은 **스테이징된 파일만** — 전체를 보면 커밋과 무관한 잔재 때문에 막힌다.
# 스캔이 "아무것도 안 보고 0건" 으로 통과하는 사고(2026-09-28)를 막기 위해
# 대상 개수를 세어 **0이면 조용히 통과하지 않고 알려 준다.**

set -e
ROOT=$(git rev-parse --show-toplevel)
SCAN="$ROOT/scripts/scan-cjk.py"

[ -x "$SCAN" ] || [ -f "$SCAN" ] || {
  echo "scan-cjk.py 를 찾을 수 없다 — 검사를 건너뛴다" >&2
  exit 0
}

# 스테이징된 텍스트 파일 목록 (삭제된 파일은 제외)
FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$FILES" ]; then
  echo "scan: 스테이징된 파일 없음 — 검사 대상 0건"
  exit 0
fi

COUNT=$(printf '%s\n' "$FILES" | wc -l | tr -d ' ')
echo "scan: ${COUNT}개 파일 검사"

# 존재하는 것만 넘긴다 (스테이징 목록과 실제 파일이 어긋나면 조용히 0건 이 된다)
EXISTING=""
for f in $FILES; do
  [ -f "$ROOT/$f" ] && EXISTING="$EXISTING $f"
done

if [ -z "$EXISTING" ]; then
  echo "scan: 검사 대상이 0개 — 경고를 무시하지 마세요(파일 목록이 실제와 다름)" >&2
  exit 0
fi

python3 "$SCAN" $EXISTING
